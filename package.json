{
  "name": "artemisa-assistant",
  "version": "1.0.0",
  "description": "WhatsApp AI bot - Secretaria Virtual para psicólogo",
  "main": "src/bot/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bot/index.ts",
    "build": "tsc",
    "start": "tsx src/bot/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:edge": "deno test --allow-env --allow-read --no-lock supabase/functions/_shared/phase1.test.ts",
    "deploy:webhook": "supabase functions deploy webhook --no-verify-jwt",
    "deploy:send-message": "supabase functions deploy send-message --no-verify-jwt",
    "db:migrate": "supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.21.0",
    "@anthropic-ai/sdk": "^0.18.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0"
  }
}
